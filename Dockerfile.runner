FROM golang:1.25-bookworm AS build

WORKDIR /src
ARG VERSION=dev
COPY go.mod ./
COPY . .
RUN go build -ldflags "-X main.version=${VERSION:-dev}" -o /out/codex-reviewer ./cmd/codex-reviewer

FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git openssh-client ripgrep \
  && npm install -g @openai/codex \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/codex-reviewer /usr/local/bin/codex-reviewer
COPY .codex /opt/codex-reviewer/codex
COPY scripts/docker-entrypoint.sh /usr/local/bin/codex-reviewer-docker-entrypoint

RUN chmod +x /usr/local/bin/codex-reviewer-docker-entrypoint \
  && chmod -R a+rX /opt/codex-reviewer

ENV CODEX_HOME=/tmp/codex-home

WORKDIR /workspace
ENTRYPOINT ["codex-reviewer-docker-entrypoint"]
CMD ["codex-reviewer"]
